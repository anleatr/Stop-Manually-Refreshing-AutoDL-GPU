{
  "name": "autodl-gpu-watch",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "AutoDL 可选 GPU 型号的资源监测、新建与同地区数据盘克隆助手",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "stop": "node scripts/stop-server.mjs",
    "dev": "node --watch src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts-check.mjs",
    "browser:install": "playwright install chromium",
    "test:ui": "node scripts/ai-ui-smoke.mjs",
    "test:login-ui": "node scripts/login-ui-smoke.mjs",
    "test:models-ui": "node scripts/models-ui-smoke.mjs",
    "test:tasks-ui": "node scripts/tasks-ui-smoke.mjs",
    "test:account-ui": "node scripts/account-ui-smoke.mjs",
    "diagnose:network": "node scripts/network-check.mjs",
    "test:images-ui": "node scripts/images-ui-smoke.mjs",
    "test:submit-ui": "node scripts/submit-ui-smoke.mjs",
    "test:plan-ui": "node scripts/plan-ui-smoke.mjs",
    "eval:plan": "node scripts/eval-plan.mjs"
  },
  "dependencies": {
    "playwright": "^1.56.0"
  }
}
